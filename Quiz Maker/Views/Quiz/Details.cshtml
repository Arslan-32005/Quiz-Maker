@model Quiz_Maker.Models.Quiz
@{
    ViewData["Title"] = "Quiz Details";
    var shareLink = Url.Action("Take", "Quiz", new { shareCode = Model.ShareCode }, Context.Request.Scheme);
}

<div class="dashboard">
    <div class="dashboard-header">
        <h2>@Model.Title</h2>
    </div>

    <div class="dashboard-section mb-3">
        <p><strong>Source file:</strong> @Model.SourceFileName</p>
        <p><strong>Total questions:</strong> @Model.TotalQuestions</p>
        <div class="dashboard-section mb-3">
            <h5 class="mb-2">Share this quiz</h5>
            <p class="text-muted small mb-3">Please Login First to use the link.</p>
            <div class="share-box">
                <input type="text" id="shareLink" class="form-control" value="@shareLink" readonly />
                <button type="button" id="copyLinkBtn" class="btn btn-primary">Copy link</button>
            </div>
            <small id="copyStatus" class="text-success d-block mt-2"></small>
        </div>
    </div>

    @foreach (var question in Model.Questions.OrderBy(q => q.Order))
    {
        <div class="question">
            <h5>@question.Order. @question.Text</h5>
            <ul>
                @foreach (var option in question.Options.OrderBy(o => o.Order))
                {
                    var letter = (char)('a' + option.Order - 1);
                    <li class="@(option.IsCorrect ? "text-success fw-bold" : "")">@letter) @option.Text</li>
                }
            </ul>
            <small>@question.Explanation</small>
        </div>
    }

    <div class="mt-3">
        <a asp-action="MyQuizzes" asp-controller="Quiz">Back to My Quizzes</a>
    </div>
</div>
@section Scripts {
    <script src="~/js/details.js" asp-append-version="true"></script>
}