@model List<Quiz_Maker.Models.Quiz>
@{
    ViewData["Title"] = "My Quizzes";
}

<div class="dashboard">
    <div class="dashboard-header">
        <h2>My Quizzes</h2>
        @if (Model.Any())
        {
            <a class="btn btn-primary" asp-controller="Quiz" asp-action="Upload">Create new quiz</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="dashboard-section dashboard-empty">
            <p>No Quiz has been created yet.</p>
            <a class="btn btn-primary" asp-controller="Quiz" asp-action="Upload">Create new quiz</a>
        </div>
    }
    else
    {
        @foreach (var quiz in Model)
        {
            <div class="dashboard-section mb-3 d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div>
                    <h5 class="mb-1">@quiz.Title</h5>
                    <small class="text-muted">Questions: @quiz.TotalQuestions</small>
                </div>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@quiz.Id">Details</a>
                    <form asp-action="Delete" asp-route-id="@quiz.Id" method="post" data-confirm="Do you want to delete this quiz?">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/myquizzes.js" asp-append-version="true"></script>
}