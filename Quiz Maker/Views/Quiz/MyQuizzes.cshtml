@model List<Quiz_Maker.Models.Quiz>
@{
    ViewData["Title"] = "My Quiz";
}
<h2>My Quizzes</h2>
@if (!Model.Any())
{
    <p>Quiz have not been created yet.</p>
}
else
{
    <div class="list-group">
        @foreach (var quiz in Model)
        {
            <div class="list-group-item">
                <h5>@quiz.Title</h5>
                <p>Questions: @quiz.TotalQuestions</p>
                <a asp-action="Details" asp-route-id="@quiz.Id">Details</a>
                <form asp-action="Delete" asp-route-id="@quiz.Id" method="post"
                      onsubmit="return confirm('Do you want to delete this quiz?');">
                    <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
            </div>
        }
    </div>
}
