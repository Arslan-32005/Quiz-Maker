@using Microsoft.AspNetCore.Identity
@using Quiz_Maker.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    <span class="fw-semibold text-dark">Hello @(currentUser?.DisplayName ?? User.Identity?.Name)</span>
}
else
{
    <a class="nav-link text-dark" href="/Account/Register">Register</a>
    <a class="nav-link text-dark" href="/Account/Login">Login</a>
}